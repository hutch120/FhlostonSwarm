{
  "name": "fhloston-swarm",
  "version": "0.1.0",
  "description": "Cutting-edge LLM analysis, pointed at your application",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "swarm": "./bin/swarm.js"
  },
  "workspaces": [
    "src/web",
    "src/api",
    "src/agents",
    "src/infra",
    "src/shared",
    "src/synthetic-target"
  ],
  "scripts": {
    "swarm": "tsx swarm.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
